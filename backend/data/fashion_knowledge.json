  "style_rules": [
    {
      "id": "fit_proportion",
      "title": "Fit proportion balance",
      "rule": "Pair a fitted top with relaxed bottoms, or vice versa. Avoid two oversized pieces together — the look becomes shapeless.",
      "categories": []
    },
    {
      "id": "chunky_with_baggy",
      "title": "Chunky shoes with baggy silhouettes",
      "rule": "Baggy or oversized silhouettes need visual weight at the feet. Chunky sneakers, boots, or platform shoes balance the proportions. Slim shoes with wide fits look unfinished.",
      "categories": ["jeans", "trousers", "hoodie", "jacket"]
    },
    {
      "id": "slim_shoes_with_slim_fit",
      "title": "Slim shoes with slim/tapered fits",
      "rule": "Slim tapered trousers and jeans work best with slim-profile shoes: clean white sneakers, loafers, derbies, or sleek chelsea boots. Chunky shoes overwhelm slim silhouettes.",
      "categories": ["jeans", "chinos", "trousers"]
    },
    {
      "id": "one_pattern",
      "title": "One pattern at a time",
      "rule": "When wearing a patterned piece (stripes, checks, floral), keep all other items solid. Two patterns together require expert-level skill to pull off.",
      "categories": []
    },
    {
      "id": "color_thirds",
      "title": "60-30-10 color rule",
      "rule": "Build outfits with 60% dominant color (trousers/jeans), 30% secondary (top), 10% accent (shoes/accessories). This creates visual balance without looking too coordinated.",
      "categories": []
    },
    {
      "id": "black_navy",
      "title": "Black and navy warning",
      "rule": "Avoid pairing navy and black in the same outfit — they clash subtly in natural light and look like a mismatch. Use charcoal grey with navy instead.",
      "categories": ["shirt", "tshirt", "jeans", "trousers"]
    },
    {
      "id": "tuck_fitted",
      "title": "Tuck fitted tops",
      "rule": "Fitted shirts and polos look cleaner tucked in with chinos or trousers. Leave tshirts and oversized tops untucked.",
      "categories": ["shirt", "polo", "chinos", "trousers"]
    },
    {
      "id": "layer_length",
      "title": "Layering length rule",
      "rule": "When layering (tshirt under an open shirt or jacket), each layer should be slightly longer than the one on top. A peeking inner layer looks intentional; uneven hems look sloppy.",
      "categories": ["tshirt", "shirt", "jacket", "hoodie"]
    }
  ],
